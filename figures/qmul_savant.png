		<style id="wp-custom-css">
			.entry-meta {
 display: none;
}

#primary .entry-title {
 text-align: center;
}

.entry-title,
.entry-title a {
 font-size: 24px;
font-family: helvetica neue; sans serif;
color: #ffffff;
}

.site-title {
font-family: helvetica neue; sans serif; color: #ffffff ;
font-size: 52px;
}

.entry-content h6 {
font-size: 13px;
}

.site-branding.col-md-6 {
 width: 100%;
 text-align: center;
}

#content blockquote {
 font-size: 12px;
}

/* Get rid of line */
#content blockquote {
 font-size: 14px;
 border-left: 0;
}

.site-description {
 color: #ffffff;
 font-family: Helvetica Neue; sans serif;
font-size: 16px;
}

h1, .entry-title {
font-size: 36px;
}

h3, .widget-title {
 font-size: 24px;
}

body {
 font-family: helvetica, sans serif;
font-size: 14pt
}

li {
  font-size:16px;
}

/* for centering nav bar */
@media (min-width: 768px) {
 .navbar-nav {
 float: none;
 padding: auto;
 }
 .nav {
 padding-left: 15%;
 }
